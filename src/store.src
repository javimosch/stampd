// store.src — the tiny persistence behind stampd Pro: which Pro keys exist.
// A Pro key is the paid entitlement — it is minted when a Stripe payment completes and
// is required to generate a BRANDED client report. Everything else (the calculator, the
// JSON API) is free and unmetered, so this store only ever holds paid keys.
//
// SQLite, opened per call (WAL + busy_timeout) so concurrent machweb goroutines don't
// share a handle. Volume is tiny (a key check per branded report), so per-call open is
// cheaper than a pool here.

func store_path() (p) {
    p = env("STAMPD_DB")
    if p == "" { p = "stampd.db" }
}

// store_init — create the tables. Idempotent; called once at startup and harmless to
// repeat. Also used by tests against a :memory: / temp path.
func store_init(db) {
    sqlite_exec(db, "CREATE TABLE IF NOT EXISTS pro_keys (key TEXT PRIMARY KEY, email TEXT, session_id TEXT, created INTEGER)")
    sqlite_exec(db, "CREATE TABLE IF NOT EXISTS api_usage (ip TEXT, day INTEGER, count INTEGER, PRIMARY KEY(ip, day))")
}

// usage_check_and_incr — the free-use ceiling for the unmetered API/email routes. Not a
// monetization cap (the calc engine costs nothing to run) — it's an anti-abuse ceiling so
// a runaway/malicious client can't hammer the server or the Resend send quota. `limit<=0`
// disables the check entirely. Returns 1 and increments the counter if under the limit
// (so a caller who is denied doesn't also get counted), else 0 without incrementing.
func usage_check_and_incr(ip, limit, ts) (ok) {
    ok = 1
    if limit <= 0 { return ok }
    day := day_bucket(ts)
    db := sqlite_open(store_path())
    sqlite_exec(db, "PRAGMA busy_timeout=3000")
    store_init(db)
    rows := sqlite_query(db, "SELECT count FROM api_usage WHERE ip = ? AND day = ?", []string{ip, str(day)})
    cnt := 0
    craw, cerr := json_get(rows, "[0].count")
    if cerr == "" { cnt = parse_int(craw) }
    if cnt >= limit {
        sqlite_close(db)
        ok = 0
        return ok
    }
    sqlite_exec(db, "INSERT INTO api_usage(ip,day,count) VALUES(?,?,1) ON CONFLICT(ip,day) DO UPDATE SET count=count+1",
        []string{ip, str(day)})
    sqlite_close(db)
}

// mint_pro_key — a fresh Pro key token. Prefix makes it self-describing in logs/emails.
func mint_pro_key() (k) { k = "stmp_" + to_hex(rand_bytes(16)) }

// pro_key_add — record a paid key. Returns 1 on success. Opens/inits/closes its own
// handle so it is safe to call from a request goroutine.
func pro_key_add(key, email, sid) (ok) {
    ok = 0
    db := sqlite_open(store_path())
    sqlite_exec(db, "PRAGMA busy_timeout=3000")
    store_init(db)
    sqlite_exec(db, "INSERT OR IGNORE INTO pro_keys (key, email, session_id, created) VALUES (?, ?, ?, 0)",
        []string{key, email, sid})
    sqlite_close(db)
    ok = 1
}

// pro_session_seen — 1 if a Pro key was already minted for this Stripe checkout
// session_id, else 0. Guards the webhook against Stripe's at-least-once delivery
// (retries on timeout / non-2xx / duplicate send) so a retried event doesn't mint a
// second key and send a second email for the same payment.
func pro_session_seen(sid) (ok) {
    ok = 0
    if sid == "" { return ok }
    db := sqlite_open(store_path())
    sqlite_exec(db, "PRAGMA busy_timeout=3000")
    store_init(db)
    rows := sqlite_query(db, "SELECT key FROM pro_keys WHERE session_id = ?", []string{sid})
    sqlite_close(db)
    if rows != "" && rows != "[]" { ok = 1 }
}

// pro_key_valid — 1 if `key` is a known paid key, else 0. Empty key is never valid.
func pro_key_valid(key) (ok) {
    ok = 0
    if key == "" { return ok }
    db := sqlite_open(store_path())
    sqlite_exec(db, "PRAGMA busy_timeout=3000")
    store_init(db)
    rows := sqlite_query(db, "SELECT key FROM pro_keys WHERE key = ?", []string{key})
    sqlite_close(db)
    // The WHERE already filters to this key, so a non-empty result array means it exists.
    if rows != "" && rows != "[]" { ok = 1 }
}
