// server.src — the stampd HTTP service: agent-first JSON API + the hosted human
// calculator + Resend email reports + a Stripe Pro tier. Composed last (after
// framework/machweb.src, src/sdlt.src, src/core.src, src/cli.src, src/assets.src).
//
// One binary: `stampd serve -port 8080` runs this; any other argv runs the CLI.

func err_json(status, msg) (r) {
    r = cors_open(response(status, "application/json", "{\"ok\":false,\"error\":" + json(msg) + "}"))
}

// cors_open — allow any browser origin to read the public JSON endpoints.
//
// Needed because the UI and the API can live on DIFFERENT origins: a landing page
// hosted as a hart artifact (hart.intrane.fr) calling this API is a cross-origin
// fetch, which the browser blocks without this header no matter how permissive the
// page's CSP is. Discovered by spiking exactly that (hart CSP allowed the call;
// the missing ACAO header killed it).
//
// `*` is correct here rather than lax: /api/calc is public, read-only, takes no
// credentials and sets no cookies, so there is nothing for a hostile origin to
// steal by reading it. Never widen this to the Pro/branded or Stripe routes,
// which ARE key-gated.
func cors_open(res) (r) {
    r = with_header(res, "Access-Control-Allow-Origin", "*")
    r = with_header(r, "Access-Control-Allow-Methods", "GET, POST, OPTIONS")
    r = with_header(r, "Access-Control-Allow-Headers", "content-type")
    r = with_header(r, "Access-Control-Max-Age", "86400")
}

// qdef — a query param with a fallback default.
func qdef(req, name, def) (v) {
    v = query(req, name)
    if v == "" { v = def }
}

// jbody — a string field out of a JSON request body, "" if absent.
func jbody(body, path) (v) {
    raw, err := json_get(body, path)
    v = ""
    if err == "" { v = unq_json(raw) }
}

// report_from_params — validate the 7 calc inputs (as strings) and return the shared
// JSON report, or ("", errmsg) on a validation failure.
func report_from_params(price_s, buyer, nonres_s, dep_s, rate_s, years_s, income_s) (out, errmsg) {
    out = ""
    errmsg = ""
    if price_s == "" { errmsg = "missing price"  return }
    price := parse_int(price_s)
    if price <= 0 { errmsg = "price must be a positive integer"  return }
    if buyer == "" { buyer = "standard" }
    if buyer_ok(buyer) == 0 { errmsg = "buyer must be standard, first_time or additional"  return }
    nonres := 0
    if nonres_s == "1" { nonres = 1 }
    dep := parse_int(dep_s)
    if dep < 0 || dep > 100 { errmsg = "deposit_pct must be 0..100"  return }
    rate := parse_float(rate_s)
    years := parse_int(years_s)
    if years <= 0 { years = 25 }
    income := parse_int(income_s)
    out = calc_report(price, buyer, nonres, dep, rate, years, income, 1500, 600, 999)
}

// daily_limit — the free-use ceiling (per IP per day), across /api/calc and
// /v1/report/email. Not a monetization cap — the calc is free compute; this exists so a
// runaway or malicious client can't hammer the server. STAMPD_DAILY_LIMIT<=0 disables it.
func daily_limit() (n) {
    n = 200
    v := env("STAMPD_DAILY_LIMIT")
    if v != "" { n = parse_int(v) }
}

// quota_gate — 1 if this request is under today's free-use ceiling for its IP (and counts
// it), else 0 (a 429 should be returned without counting the denied call).
func quota_gate(req) (ok) { ok = usage_check_and_incr(client_ip(req), daily_limit(), now()) }

// api_calc — GET|POST /api/calc — the agent-first JSON endpoint.
func api_calc(req) (res) {
    if quota_gate(req) == 0 {
        return err_json("429 Too Many Requests", "free-use limit reached (" + str(daily_limit()) + "/day per IP) — try again tomorrow, or self-host: github.com/javimosch/stampd")
    }
    price_s := qdef(req, "price", "")
    buyer := qdef(req, "buyer", "standard")
    nonres_s := qdef(req, "non_resident", "0")
    dep_s := qdef(req, "deposit_pct", "10")
    rate_s := qdef(req, "rate", "4.5")
    years_s := qdef(req, "years", "25")
    income_s := qdef(req, "income", "0")
    // Allow a JSON POST body to supply the same fields.
    if req.method == "POST" && len(req.body) > 2 {
        if jbody(req.body, ".price") != "" { price_s = jbody(req.body, ".price") }
        if jbody(req.body, ".buyer") != "" { buyer = jbody(req.body, ".buyer") }
        if jbody(req.body, ".non_resident") != "" { nonres_s = jbody(req.body, ".non_resident") }
        if jbody(req.body, ".deposit_pct") != "" { dep_s = jbody(req.body, ".deposit_pct") }
        if jbody(req.body, ".rate") != "" { rate_s = jbody(req.body, ".rate") }
        if jbody(req.body, ".years") != "" { years_s = jbody(req.body, ".years") }
        if jbody(req.body, ".income") != "" { income_s = jbody(req.body, ".income") }
    }
    out, errmsg := report_from_params(price_s, buyer, nonres_s, dep_s, rate_s, years_s, income_s)
    if errmsg != "" { return err_json("400 Bad Request", errmsg) }
    res = cors_open(ok_json(out))
}

// email_body — a plain-text cost breakdown for the Resend email.
func email_body(price_s, report) (b) {
    b = "Your stampd home-buying cost breakdown\n" +
        "=======================================\n\n" +
        "Purchase price: " + gbp(parse_int(price_s)) + "\n\n" +
        "Total cash needed on completion: " + gbp(parse_int(jval(report, ".result.total_upfront_cash"))) + "\n\n" +
        "Stamp Duty (SDLT):   " + gbp(parse_int(jval(report, ".result.stamp_duty"))) + "\n" +
        "Deposit:             " + gbp(parse_int(jval(report, ".result.deposit"))) + "\n" +
        "Legal / conveyancing:" + gbp(parse_int(jval(report, ".result.legal_fee"))) + "\n" +
        "Survey:              " + gbp(parse_int(jval(report, ".result.survey_fee"))) + "\n" +
        "Mortgage fee:        " + gbp(parse_int(jval(report, ".result.mortgage_fee"))) + "\n" +
        "Land Registry:       " + gbp(parse_int(jval(report, ".result.land_registry_fee"))) + "\n\n" +
        "Mortgage borrowed:   " + gbp(parse_int(jval(report, ".result.loan"))) + "\n" +
        "Monthly repayment:   " + gbp(parse_int(jval(report, ".result.monthly_payment"))) + " / month\n\n" +
        "Estimates only. Not tax, legal, or financial advice.\n" +
        "Rates effective 1 April 2025. — https://stampd.intrane.fr\n"
}

// jval — an inner JSON value (number or string, unquoted) from the report.
func jval(body, path) (v) {
    raw, err := json_get(body, path)
    v = ""
    if err == "" { v = unq_json(raw) }
}

// send_email — send one transactional email via Resend. Returns 1 on success, 0 on any
// failure (missing key, provider rejection). Shared by the email-report route and the
// Pro-key delivery on the Stripe webhook.
func send_email(to, subject, text) (ok) {
    ok = 0
    key := env("RESEND_API_KEY")
    if key == "" { return ok }
    from := env("STAMPD_FROM")
    if from == "" { from = "stampd <onboarding@resend.dev>" }
    payload := "{\"from\":" + json(from) +
        ",\"to\":[" + json(to) + "]" +
        ",\"subject\":" + json(subject) +
        ",\"text\":" + json(text) + "}"
    status, _, herr := http_request("POST", "https://api.resend.com/emails",
        []string{"authorization: Bearer " + key, "content-type: application/json"}, payload)
    if herr == "" && status >= 200 && status < 300 { ok = 1 }
}

// email_report — POST /v1/report/email — build the report and send it via Resend.
func email_report(req) (res) {
    if quota_gate(req) == 0 {
        return err_json("429 Too Many Requests", "free-use limit reached (" + str(daily_limit()) + "/day per IP) — try again tomorrow, or self-host: github.com/javimosch/stampd")
    }
    to := jbody(req.body, ".to")
    if to == "" || index(to, "@") < 0 { return err_json("400 Bad Request", "a valid 'to' email is required") }
    price_s := jbody(req.body, ".price")
    buyer := jbody(req.body, ".buyer")
    nonres_s := jbody(req.body, ".non_resident")
    dep_s := jbody(req.body, ".deposit_pct")
    rate_s := jbody(req.body, ".rate")
    years_s := jbody(req.body, ".years")
    income_s := jbody(req.body, ".income")
    if dep_s == "" { dep_s = "10" }
    if rate_s == "" { rate_s = "4.5" }
    if years_s == "" { years_s = "25" }
    if income_s == "" { income_s = "0" }
    report, errmsg := report_from_params(price_s, buyer, nonres_s, dep_s, rate_s, years_s, income_s)
    if errmsg != "" { return err_json("400 Bad Request", errmsg) }

    if env("RESEND_API_KEY") == "" { return err_json("503 Service Unavailable", "email is not configured on this server") }
    text := email_body(price_s, report)
    if send_email(to, "Your home-buying cost breakdown — stampd", text) == 0 {
        return err_json("502 Bad Gateway", "email provider rejected the send")
    }
    res = ok_json("{\"ok\":true,\"sent\":true,\"to\":" + json(to) + "}")
}

// checkout — POST /v1/checkout — a Stripe Checkout session for stampd Pro (a one-off
// unlock for unlimited branded reports + API access). Returns the hosted checkout URL.
func checkout(req) (res) {
    key := env("STRIPE_SECRET_KEY")
    if key == "" { return err_json("503 Service Unavailable", "billing is not configured on this server") }
    base := env("STAMPD_PUBLIC_URL")
    if base == "" { base = "https://stampd.intrane.fr" }
    body := "mode=payment" +
        "&line_items[0][quantity]=1" +
        "&line_items[0][price_data][currency]=gbp" +
        "&line_items[0][price_data][product_data][name]=" + url_encode("stampd Pro — branded client reports for international-buyer specialists") +
        "&line_items[0][price_data][unit_amount]=2900" +
        "&success_url=" + url_encode(base + "/?pro=ok&sid={CHECKOUT_SESSION_ID}") +
        "&cancel_url=" + url_encode(base + "/") +
        "&metadata[kind]=pro"
    status, resp, herr := http_request("POST", "https://api.stripe.com/v1/checkout/sessions",
        []string{"authorization: Bearer " + key, "content-type: application/x-www-form-urlencoded"}, body)
    if herr != "" || status != 200 { return err_json("502 Bad Gateway", "could not start checkout") }
    u, gerr := json_get(resp, ".url")
    if gerr != "" { return err_json("502 Bad Gateway", "checkout url missing") }
    uu := u
    n := len(uu)
    if n >= 2 { if substr(uu, 0, 1) == "\"" { uu = substr(uu, 1, n-1) } }
    res = ok_json("{\"ok\":true,\"url\":" + json(uu) + "}")
}

// stripe_webhook — POST /v1/stripe/webhook — verify the Stripe-Signature HMAC (the raw
// body is the signed payload) and acknowledge. Payment fulfilment is a no-op for now
// (Pro is stateless: the receipt is the entitlement) but the signature is still enforced.
func stripe_webhook(req) (res) {
    secret := env("STRIPE_WEBHOOK_SECRET")
    if secret == "" { return err_json("503 Service Unavailable", "webhook not configured") }
    sig := header(req, "Stripe-Signature")
    t := sig_field(sig, "t")
    v1 := sig_field(sig, "v1")
    if t == "" || v1 == "" { return err_json("400 Bad Request", "missing signature") }
    if hmac_sha256(secret, t + "." + req.body) != v1 { return err_json("400 Bad Request", "bad signature") }

    // Fulfil a completed Pro purchase: mint a Pro key, store it, email it to the buyer.
    etype := jbody(req.body, ".type")
    kind := jbody(req.body, ".data.object.metadata.kind")
    if etype == "checkout.session.completed" && kind == "pro" {
        email := jbody(req.body, ".data.object.customer_details.email")
        sid := jbody(req.body, ".data.object.id")
        // Stripe delivers webhooks at-least-once (retries on timeout/non-2xx/duplicate),
        // so the same paid session can arrive more than once. Only mint+email once per
        // session_id, or a retry double-charges nothing but double-mints a free key.
        if pro_session_seen(sid) == 0 {
            key := mint_pro_key()
            pro_key_add(key, email, sid)
            if email != "" {
                body := "Thanks for buying stampd Pro!\n\n" +
                    "Your Pro key (keep it safe):\n\n    " + key + "\n\n" +
                    "Use it to generate branded client reports:\n" +
                    "  curl -X POST https://stampd.intrane.fr/v1/report/branded \\\n" +
                    "    -H 'X-Stampd-Key: " + key + "' -H 'content-type: application/json' \\\n" +
                    "    -d '{\"price\":850000,\"buyer\":\"standard\",\"non_resident\":\"1\",\"agency_name\":\"Your Firm\",\"agent_name\":\"You\",\"phone\":\"...\",\"email\":\"you@yourfirm.co.uk\"}'\n\n" +
                    "The response is a print-ready HTML one-pager (print to PDF) carrying your\n" +
                    "firm's name and contact details, to send a client before they commit.\n\n" +
                    "— https://stampd.intrane.fr\n"
                send_email(email, "Your stampd Pro key", body)
            }
        }
    }
    res = ok_json("{\"ok\":true,\"received\":true}")
}

// pro_verify — GET|POST /v1/pro/verify — is a Pro key valid? (X-Stampd-Key or ?key=)
func pro_verify(req) (res) {
    key := header(req, "X-Stampd-Key")
    if key == "" { key = query(req, "key") }
    if pro_key_valid(key) == 1 { return ok_json("{\"ok\":true,\"pro\":true}") }
    res = ok_json("{\"ok\":true,\"pro\":false}")
}

// hesc — minimal HTML escaping for user-supplied agency branding fields.
func hesc(s) (o) {
    o = replace(s, "&", "&amp;")
    o = replace(o, "<", "&lt;")
    o = replace(o, ">", "&gt;")
    o = replace(o, "\"", "&quot;")
}

// branded_row — one label/value line in the branded report table.
func branded_row(k, v) (h) {
    h = "<tr><td class=k>" + hesc(k) + "</td><td class=v>" + hesc(v) + "</td></tr>"
}

// branded_html — a self-contained, print-ready "Cost of Buying" one-pager carrying the
// estate agent's branding. This is the paid deliverable behind stampd Pro.
func branded_html(report, agency, agent, phone, aemail) (h) {
    price := gbp(parse_int(jval(report, ".input.price")))
    h = "<!doctype html><html><head><meta charset=utf-8><title>Cost of Buying — " + hesc(agency) + "</title>" +
        "<style>body{font:15px/1.6 -apple-system,Segoe UI,Roboto,Arial,sans-serif;color:#111;max-width:720px;margin:32px auto;padding:0 20px}" +
        "h1{margin:0 0 2px;font-size:24px}.sub{color:#666;margin:0 0 20px}" +
        ".hero{background:#0f6fff;color:#fff;padding:18px 22px;border-radius:12px;margin:18px 0}" +
        ".hero .big{font-size:32px;font-weight:700}" +
        "table{width:100%;border-collapse:collapse;margin-top:10px}td{padding:9px 4px;border-bottom:1px solid #eee}" +
        ".k{color:#555}.v{text-align:right;font-weight:600;font-variant-numeric:tabular-nums}" +
        ".card{border:1px solid #eee;border-radius:12px;padding:18px 22px;margin-top:22px}" +
        ".foot{color:#888;font-size:12px;margin-top:26px}@media print{.noprint{display:none}}</style></head><body>" +
        "<h1>" + hesc(agency) + "</h1><p class=sub>Cost of Buying report &middot; prepared by " + hesc(agent) +
        " &middot; " + hesc(phone) + " &middot; " + hesc(aemail) + "</p>" +
        "<div class=card><div class=sub>Purchase price</div><div style='font-size:26px;font-weight:700'>" + price + "</div>" +
        "<div class=hero><div>Total cash needed on completion</div><div class=big>" +
        gbp(parse_int(jval(report, ".result.total_upfront_cash"))) + "</div></div>" +
        "<table>" +
        branded_row("Stamp Duty (SDLT)", gbp(parse_int(jval(report, ".result.stamp_duty"))) + "  (" + jval(report, ".result.stamp_duty_effective_pct") + "%)") +
        branded_row("Deposit", gbp(parse_int(jval(report, ".result.deposit")))) +
        branded_row("Legal / conveyancing", gbp(parse_int(jval(report, ".result.legal_fee")))) +
        branded_row("Survey", gbp(parse_int(jval(report, ".result.survey_fee")))) +
        branded_row("Mortgage arrangement fee", gbp(parse_int(jval(report, ".result.mortgage_fee")))) +
        branded_row("Land Registry", gbp(parse_int(jval(report, ".result.land_registry_fee")))) +
        branded_row("Mortgage borrowed", gbp(parse_int(jval(report, ".result.loan")))) +
        branded_row("Monthly repayment", gbp(parse_int(jval(report, ".result.monthly_payment"))) + " / month") +
        "</table></div>" +
        "<p class=foot>Estimates only &mdash; not tax, legal, or financial advice. England &amp; Northern Ireland SDLT rates effective 1 April 2025. Generated by stampd &middot; stampd.intrane.fr</p>" +
        "</body></html>"
}

// hart_publish — publish self-contained HTML to hart.intrane.fr under the "stampd" owner
// namespace (claimed with HART_OWNER_KEY) and return its live shareable URL. `errmsg` is
// non-empty on any failure (not configured, transport error, bad response) — the caller
// falls back to returning the HTML directly rather than failing the request.
func hart_publish(html, title) (url, errmsg) {
    url = ""
    errmsg = ""
    key := env("HART_OWNER_KEY")
    if key == "" { errmsg = "hart not configured"  return }
    base := env("HART_URL")
    if base == "" { base = "https://hart.intrane.fr" }
    slug := "report-" + to_hex(rand_bytes(5))
    u := base + "/v1/publish?owner=stampd&artifact=" + slug + "&visibility=unlisted&title=" + url_encode(title)
    status, resp, herr := http_request("POST", u, []string{"x-hart-owner-key: " + key, "content-type: text/html"}, html)
    if herr != "" || status < 200 || status >= 300 { errmsg = "hart publish failed"  return }
    raw, gerr := json_get(resp, ".url")
    if gerr != "" { errmsg = "hart response missing url"  return }
    url = unq_json(raw)
}

// report_branded — POST /v1/report/branded — the KEY-GATED paid endpoint. Requires a
// valid Pro key (header X-Stampd-Key). Publishes the branded report to hart and returns
// its live shareable URL — a link the caller can text/email a client, instead of an HTML
// blob they must save and print-to-PDF themselves. Falls back to returning the HTML
// directly if hart isn't configured or the publish call fails.
func report_branded(req) (res) {
    key := header(req, "X-Stampd-Key")
    if key == "" { key = query(req, "key") }
    if pro_key_valid(key) == 0 {
        return err_json("402 Payment Required", "a valid stampd Pro key is required (buy Pro at /?pro), pass it as X-Stampd-Key")
    }
    price_s := jbody(req.body, ".price")
    buyer := jbody(req.body, ".buyer")
    nonres_s := jbody(req.body, ".non_resident")
    dep_s := jbody(req.body, ".deposit_pct")
    rate_s := jbody(req.body, ".rate")
    years_s := jbody(req.body, ".years")
    income_s := jbody(req.body, ".income")
    if dep_s == "" { dep_s = "10" }
    if rate_s == "" { rate_s = "4.5" }
    if years_s == "" { years_s = "25" }
    if income_s == "" { income_s = "0" }
    report, errmsg := report_from_params(price_s, buyer, nonres_s, dep_s, rate_s, years_s, income_s)
    if errmsg != "" { return err_json("400 Bad Request", errmsg) }
    agency := jbody(req.body, ".agency_name")
    if agency == "" { agency = "Your Agency" }
    agent := jbody(req.body, ".agent_name")
    phone := jbody(req.body, ".phone")
    aemail := jbody(req.body, ".email")
    html := branded_html(report, agency, agent, phone, aemail)
    url, herr := hart_publish(html, agency + " — Cost of Buying")
    if herr == "" { return ok_json("{\"ok\":true,\"url\":" + json(url) + ",\"format\":\"hart\"}") }
    res = ok_html(html)
}

// feedback — POST /v1/feedback — accept an agent/user note (cli-feedback-spec sink).
// Appended to a local log; never fails the caller with a 5xx for a well-formed note.
func feedback(req) (res) {
    msg := jbody(req.body, ".message")
    if msg == "" { return err_json("400 Bad Request", "message required") }
    write(2, "{\"feedback\":" + json(msg) + "}\n")
    res = ok_json("{\"ok\":true}")
}

func llms_txt() (s) {
    s = "# stampd\n" +
        "> The true cost of buying UK property (England & Northern Ireland), with a focus on\n" +
        "> OVERSEAS / NON-UK-RESIDENT buyers of London property: the 2% non-resident SDLT\n" +
        "> surcharge, its stacking with the additional-property surcharge, plus deposit,\n" +
        "> legal, survey, Land Registry, mortgage repayment and total cash on completion.\n" +
        "> Agent-first JSON API. SDLT rates effective 1 April 2025.\n\n" +
        "## API\n" +
        "- GET /api/calc?price=850000&buyer=standard&deposit_pct=25&rate=4.5&years=25&income=0&non_resident=1\n" +
        "  -> {\"ok\":true,\"input\":{...},\"result\":{stamp_duty,deposit,loan,monthly_payment,land_registry_fee,total_upfront_cash,income_multiple,affordable,...}}\n" +
        "- POST /api/calc  (same fields as a JSON body)\n" +
        "- POST /v1/report/email  {\"to\":\"a@b.com\",\"price\":850000,\"buyer\":\"standard\",\"non_resident\":\"1\",...}  emails the breakdown\n\n" +
        "Both routes above are free up to a generous per-IP daily ceiling (default 200/day,\n" +
        "anti-abuse only, not a paywall) — past it they return 429. Self-hosting (OSS) has\n" +
        "no ceiling.\n\n" +
        "## Pro (paid)\n" +
        "The calculator + JSON API are free. stampd Pro (£29 one-off, for relocation\n" +
        "consultants / international-buyer specialist agencies) mints a Pro key that\n" +
        "unlocks BRANDED client reports:\n" +
        "- POST /v1/checkout -> {\"url\":...}  Stripe Checkout; the Pro key is emailed on payment.\n" +
        "- POST /v1/report/branded  (header X-Stampd-Key: <key>)  {price,buyer,agency_name,agent_name,phone,email}\n" +
        "  -> {\"ok\":true,\"url\":...} — a live hart.intrane.fr link to the branded report\n" +
        "  (falls back to the raw HTML if hart is unreachable). 402 without a valid key.\n" +
        "- GET  /v1/pro/verify?key=<key> -> {\"pro\":true|false}\n\n" +
        "## buyer types\n" +
        "standard | first_time | additional ; non_resident=1 adds the 2% surcharge.\n\n" +
        "## Onboarding an agent\n" +
        "GET /snippet — one line to paste into an agent's system prompt / CLAUDE.md, so it\n" +
        "starts using stampd on its own (it reads this file itself; nothing to hardcode).\n\n" +
        "## Learn\n" +
        "GET /guide — full operating manual. CLI: `stampd guide` / `stampd snippet` / `stampd help-json`.\n"
}

// handle — the router.
func handle(req) (res) {
    p := req.path
    qi := index(p, "?")
    if qi >= 0 { p = substr(p, 0, qi) }

    if p == "/_health" { return ok_json("{\"ok\":true,\"service\":\"stampd\",\"version\":\"" + ver() + "\"}") }
    if p == "/" || p == "/index.html" { return ok_html(landing_html()) }
    if p == "/guide" { return ok_text(guide_text()) }
    if p == "/snippet" { return ok_text(onboarding_snippet()) }
    if p == "/llms.txt" { return ok_text(llms_txt()) }
    if p == "/help-json" { return ok_json(help_json()) }
    // CORS preflight: a JSON POST from a browser on another origin sends OPTIONS
    // first. Answer it before any other routing so it never falls through to 404.
    if req.method == "OPTIONS" { return cors_open(response("204 No Content", "text/plain", "")) }
    if p == "/api/calc" { return api_calc(req) }
    if p == "/v1/report/email" && req.method == "POST" { return email_report(req) }
    if p == "/v1/checkout" && req.method == "POST" { return checkout(req) }
    if p == "/v1/report/branded" && req.method == "POST" { return report_branded(req) }
    if p == "/v1/pro/verify" { return pro_verify(req) }
    if p == "/v1/stripe/webhook" && req.method == "POST" { return stripe_webhook(req) }
    if p == "/v1/feedback" && req.method == "POST" { return feedback(req) }
    res = not_found()
}

// port_flag — the listen port from serve's argv. Accepts either `-port N` / `--port N`
// or a bare positional `serve N` (default 8080).
func port_flag() (p) {
    p = 8080
    a := args()
    i := 2
    for i < len(a) {
        if a[i] == "-port" || a[i] == "--port" {
            if i+1 < len(a) { p = parse_int(a[i+1]) }
        } else {
            n := parse_int(a[i])
            if n > 0 { p = n }
        }
        i = i + 1
    }
}

func main() {
    a := args()
    cmd := ""
    if len(a) >= 2 { cmd = a[1] }
    if cmd == "serve" {
        db := sqlite_open(store_path())
        sqlite_exec(db, "PRAGMA journal_mode=WAL")
        store_init(db)
        sqlite_close(db)
        serve(port_flag(), func(req) { return handle(req) })
        return
    }
    run_cli()
}
