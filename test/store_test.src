// Unit tests for src/store.src — the Pro-key store (the paid entitlement).
// Run with a throwaway DB: STAMPD_DB=/tmp/stampd_test.db machin test src/store.src test/store_test.src
// (the test.sh harness sets STAMPD_DB and removes the file first).

func test_mint_pro_key() {
    k := mint_pro_key()
    assert(has_prefix(k, "stmp_"), "mint_pro_key has stmp_ prefix")
    // "stmp_" (5) + 32 hex chars (16 bytes) = 37.
    assert_eq_int(len(k), 37, "mint_pro_key length")
}

func test_pro_key_lifecycle() {
    // Unknown / empty keys are never valid.
    assert_eq_int(pro_key_valid(""), 0, "empty key invalid")
    assert_eq_int(pro_key_valid("stmp_nope"), 0, "unknown key invalid")
    // After adding a key, it validates; a different key still does not.
    k := mint_pro_key()
    pro_key_add(k, "agent@agency.co.uk", "cs_test_123")
    assert_eq_int(pro_key_valid(k), 1, "added key is valid")
    assert_eq_int(pro_key_valid("stmp_other"), 0, "other key still invalid")
}

func test_pro_session_seen() {
    assert_eq_int(pro_session_seen(""), 0, "empty session_id never seen")
    assert_eq_int(pro_session_seen("cs_unknown"), 0, "unknown session_id not seen")
    k := mint_pro_key()
    pro_key_add(k, "agent@agency.co.uk", "cs_test_dup")
    assert_eq_int(pro_session_seen("cs_test_dup"), 1, "known session_id seen")
    // A second mint attempt for the same session (simulating a Stripe webhook retry)
    // must not be blocked at the store layer — the caller checks pro_session_seen
    // FIRST and skips minting; this just confirms the lookup that guard relies on.
    assert_eq_int(pro_session_seen("cs_test_dup"), 1, "still seen on repeat check")
}

func test_usage_check_and_incr() {
    // limit<=0 disables the check entirely: always ok, regardless of history.
    assert_eq_int(usage_check_and_incr("9.9.9.9", 0, 1000), 1, "usage disabled (limit 0) always ok")

    // A limit of 2: first two calls ok, third denied, same ip+day.
    assert_eq_int(usage_check_and_incr("1.1.1.1", 2, 5000000), 1, "usage call 1/2 ok")
    assert_eq_int(usage_check_and_incr("1.1.1.1", 2, 5000001), 1, "usage call 2/2 ok (same day)")
    assert_eq_int(usage_check_and_incr("1.1.1.1", 2, 5000002), 0, "usage call 3/2 denied")
    // still denied — a denied call must not have incremented the counter past the cap.
    assert_eq_int(usage_check_and_incr("1.1.1.1", 2, 5000003), 0, "usage still denied on repeat")

    // A different IP has its own independent bucket.
    assert_eq_int(usage_check_and_incr("2.2.2.2", 2, 5000000), 1, "usage different ip independent")

    // A later day (>=86400s later) resets the bucket for the same ip.
    assert_eq_int(usage_check_and_incr("1.1.1.1", 2, 5000000 + 86400), 1, "usage resets on a new day")
}

func main() {
    test_mint_pro_key()
    test_pro_key_lifecycle()
    test_pro_session_seen()
    test_usage_check_and_incr()
    test_summary()
}
